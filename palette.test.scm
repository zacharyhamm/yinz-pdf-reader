(define replies
  (hash "RequestPluginPermissions" json-null "CommandPalette" json-null "RunAction" json-null "HideSelf" json-null
        "GetPluginIds" (hash "plugin_id" 4 "client_id" 1 "initial_cwd" "/tmp")))
(define context (hash "clientId" 1 "paneId" (hash "Terminal" 7) "tabId" 1 "currentProject" json-null))
(define reader (test-resolve "./main.scm"))

(define (load-palette configuration)
  (test-load-plugin "./palette.scm" (hash "configuration" configuration "replies" replies))
  (test-event (hash "PermissionRequestResult" "Granted")))

(define (palette-commands)
  (map (lambda (c) (hash-ref c "CommandPalette"))
    (filter (lambda (c) (and (hash? c) (hash-contains? c "CommandPalette"))) (test-commands))))
(define (last-of items) (car (reverse items)))
(define (registration)
  (hash-ref (car (filter (lambda (c) (equal? (hash-ref c "type") "register")) (palette-commands))) "registration"))
(define (scope opening revision) (hash "registration" (registration) "opening" opening "view" 0 "revision" revision))
(define (discover opening)
  (test-palette (hash "type" "discover" "scope" (scope opening 1) "context" context "query" "" "source" json-null) 1)
  (define reply (last-of (palette-commands)))
  (assert-equal (hash-ref reply "type") "reply")
  (hash-ref (hash-ref (hash-ref reply "result") "Ok") "actions"))
(define (execute opening revision action)
  (test-palette (hash "type" "execute" "scope" (scope opening revision) "context" context
                      "handle" (hash-ref action "handle") "values" json-null) 1))
(define (labelled actions label) (car (filter (lambda (a) (equal? (hash-ref a "label") label)) actions)))
;; The file-finder alias launched by each RunAction, in order.
(define (launches)
  (map (lambda (c) (hash-ref (hash-ref (hash-ref (car (hash-ref c "RunAction")) "LaunchOrFocusPlugin") "plugin") "Alias"))
    (filter (lambda (c) (and (hash? c) (hash-contains? c "RunAction") (hash-contains? (car (hash-ref c "RunAction")) "LaunchOrFocusPlugin")))
      (test-commands))))
(define (openers alias) (yinz-json-parse (hash-ref (hash-ref alias "configuration") "openers_json")))
(define back (hash "pdf" (hash "plugin_id" 4 "message" "open")))
(define (pick name payload)
  (test-pipe (hash "source" (hash "Plugin" 3) "name" name "payload" payload "args" (hash)
                   "is_private" #f "pane_id" json-null)))
;; The reader pipes sent by each RunAction, in order.
(define (reader-pipes)
  (map (lambda (c) (hash-ref (car (hash-ref c "RunAction")) "KeybindPipe"))
    (filter (lambda (c) (and (hash? c) (hash-contains? c "RunAction") (hash-contains? (car (hash-ref c "RunAction")) "KeybindPipe")))
      (test-commands))))
(define (assert-tiled-open pipe target path)
  (assert-equal (hash-ref pipe "plugin") target)
  (assert-equal (hash-ref pipe "name") "open")
  (assert-equal (hash-ref pipe "payload") path)
  (assert-equal (hash-ref pipe "args") (hash "focus" "true"))
  (assert-equal (hash-ref pipe "floating") #f)
  (assert-equal (hash-ref pipe "in_place") #f))

(test "static palette inventory launches the alias and releases dismissed handles" (lambda ()
  (load-palette (hash))
  (define action (labelled (discover 1) "Open PDF…"))
  (assert-equal (hash-ref action "aliases") (list "pdf reader" "open document" "pdf open" "read pdf"))
  (execute 1 2 action)
  (define alias (car (launches)))
  (assert-equal (hash-ref alias "name") "file-finder")
  (assert-equal (hash-ref (hash-ref alias "configuration") "overlay") "true")
  (assert (not (hash-contains? (hash-ref alias "configuration") "fzf_args")))
  (assert-equal (openers alias) back)
  (test-palette (hash "type" "release" "handles" (list (hash-ref action "handle"))) 1)
  (test-palette (hash "type" "dismiss" "opening" 1) 1)
  (execute 1 3 action)
  (assert-equal (length (launches)) 1)
  (define fresh (labelled (discover 2) "Open PDF…"))
  (test-palette (hash "type" "dismiss" "opening" 2) 1)
  (execute 2 2 fresh)
  (assert-equal (length (launches)) 1)))

(test "a pick opens in a tiled sibling reader, available before any session update" (lambda ()
  (load-palette (hash))
  (execute 1 2 (labelled (discover 1) "Open PDF…"))
  (assert-equal (length (launches)) 1)
  (assert-equal (openers (car (launches))) back)
  (pick "open" "")
  (assert-equal (length (reader-pipes)) 0)
  (pick "open" "/books/it's here.pdf")
  (assert (member "HideSelf" (test-commands)))
  (assert-equal (length (reader-pipes)) 1)
  (assert-tiled-open (car (reader-pipes)) reader "/books/it's here.pdf")))

(test "a configured reader alias receives the picks" (lambda ()
  (load-palette (hash "reader" "pdf-reader"))
  (execute 1 2 (labelled (discover 1) "Open PDF…"))
  (pick "open" "/books/a.pdf")
  (assert-tiled-open (car (reader-pipes)) "pdf-reader" "/books/a.pdf")))

(test "a folder pick launches a finder over the PDFs under that folder" (lambda ()
  (load-palette (hash))
  (execute 1 2 (labelled (discover 1) "Open PDF from folder…"))
  (define folders (car (launches)))
  (assert-equal (hash-ref folders "name") "file-finder")
  (assert (string-contains? (hash-ref (hash-ref folders "configuration") "file_command") "-type d"))
  (define folder (hash "plugin_id" 4 "message" "folder"))
  (assert-equal (openers folders) (hash "pdf" folder "default" folder))
  (pick "folder" "/home/me/it's here")
  (assert (member "HideSelf" (test-commands)))
  (define pdfs (cadr (launches)))
  (assert-equal (hash-ref (hash-ref pdfs "configuration") "file_command")
    "find '/home/me/it'\\''s here' -mindepth 1 -name '.*' -prune -o -type f -iname '*.pdf' -print 2>/dev/null")
  (assert-equal (openers pdfs) back)
  (pick "open" "/home/me/it's here/a.pdf")
  (assert-tiled-open (car (reader-pipes)) reader "/home/me/it's here/a.pdf")))
