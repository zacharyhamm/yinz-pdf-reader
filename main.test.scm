(define replies
  (hash "RequestPluginPermissions" json-null "RunCommand" json-null "GetCellPixelSize" json-null "ShowSelf" json-null
        "GetPluginIds" (hash "plugin_id" 1 "client_id" 1 "initial_cwd" "/tmp")
        "DataDefineEntity" (hash) "DataFetch" (hash "columns" '() "rows" '() "truncated" #f "next_cursor" json-null)
        "DataApply" (hash)))

(define (load-main . configuration)
  (test-load-plugin "./main.scm"
    (hash "configuration" (if (null? configuration) (hash) (car configuration)) "replies" replies)))

;; RunCommand arguments: argv, env, cwd, context, max bytes, streaming.
(define (runs) (map (lambda (c) (hash-ref c "RunCommand"))
                 (filter (lambda (c) (and (hash? c) (hash-contains? c "RunCommand"))) (test-commands))))
(define (argv run) (car run))
(define (last-run) (car (reverse (runs))))
(define (finish run . options)
  (define stdout (if (null? options) "" (car options)))
  (define exit (if (or (null? options) (null? (cdr options))) 0 (cadr options)))
  (test-event (hash "RunCommandResult" (list exit (bytes->list (string->bytes stdout)) '() (cadddr run)))))
(define (pipe-open payload) (test-pipe (hash "name" "open" "payload" payload)))

(test "queues configured and early literal messages behind permissions and tools, recovering after failure" (lambda ()
  (define first "/books/first%2C.pdf ")
  (define second "/books/雪 #?%20%23%25%ZZ.pdf")
  (load-main (hash "file" first))
  (pipe-open "/missing.pdf")
  (pipe-open second)
  (test-pipe (hash "name" "other" "payload" "/ignored.pdf"))
  (pipe-open json-null)
  (pipe-open "")
  (assert (not (member (hash "ShowSelf" #f) (test-commands))))
  (assert-equal (length (runs)) 0)
  (test-event (hash "PermissionRequestResult" "Granted"))
  (assert-equal (length (runs)) 1)
  (finish (car (runs)) "/home/test\n")
  (assert-equal (argv (last-run)) (list "pdfinfo" first))
  (finish (last-run) "Pages: 2\n")
  (assert-equal (argv (last-run)) (list "pdfinfo" "-f" "1" "-l" "2" first))
  (finish (last-run))
  (assert-equal (argv (last-run)) (list "pdfinfo" "/missing.pdf"))
  (finish (last-run) "" 1)
  (assert-equal (argv (last-run)) (list "pdfinfo" second))
  (finish (last-run) "Pages: 3\n")
  (finish (last-run))
  (assert (string-contains? (test-render 20 140) "1/3"))
  (assert-equal (map (lambda (run) (cadr (argv run)))
                  (filter (lambda (run) (and (equal? (car (argv run)) "pdfinfo") (= (length (argv run)) 2))) (runs)))
    (list first "/missing.pdf" second))))

(test "a palette open focuses the reader; a plain pipe does not" (lambda ()
  (load-main)
  (pipe-open "/plain.pdf")
  (assert (not (member (hash "ShowSelf" #f) (test-commands))))
  (test-pipe (hash "name" "open" "payload" "/picked.pdf" "args" (hash "focus" "true")))
  (assert (member (hash "ShowSelf" #f) (test-commands)))))

(test "denial blocks current and future document commands until reload" (lambda ()
  (load-main (hash "file" "/first.pdf"))
  (pipe-open "/second.pdf")
  (test-event (hash "PermissionRequestResult" "Denied"))
  (pipe-open "/third.pdf")
  (assert-equal (length (runs)) 0)
  (assert (string-contains? (string-downcase (test-render)) "denied"))))

(test "waits for mutool setup and preserves relative paths after HOME discovery" (lambda ()
  (load-main)
  (test-event (hash "PermissionRequestResult" "Granted"))
  (pipe-open "~/book.pdf")
  (finish (car (runs)) "/home/test\n/usr/bin/mutool\n")
  (assert-equal (length (runs)) 2)
  (assert-equal (car (argv (cadr (runs)))) "sh")
  (finish (cadr (runs)) "/tmp/scripts\n")
  (assert-equal (argv (last-run)) (list "pdfinfo" "/home/test/book.pdf"))))

(test "failed initialization blocks later requests" (lambda ()
  (load-main)
  (test-event (hash "PermissionRequestResult" "Granted"))
  (finish (car (runs)) "" 1)
  (pipe-open "/blocked.pdf")
  (assert-equal (length (runs)) 1)
  (assert (string-contains? (test-render) "could not detect PDF tools"))))

(test "typed opening and reload use the same serial queue" (lambda ()
  (load-main)
  (define (key name)
    (test-event (hash "Key" (hash "bare_key" (if (equal? name "Enter") "Enter" (hash "Char" name)) "key_modifiers" '()))))
  (key "o")
  (for-each (lambda (c) (key (string c))) (string->list " /typed%2C.pdf "))
  (key "Enter")
  (assert-equal (length (runs)) 0)
  (test-event (hash "PermissionRequestResult" "Granted"))
  (finish (car (runs)) "/home/test\n")
  (assert-equal (argv (last-run)) (list "pdfinfo" "/typed%2C.pdf"))
  (finish (last-run) "Pages: 2\n")
  (finish (last-run))
  (key "r")
  (pipe-open "/next.pdf")
  (assert-equal (argv (last-run)) (list "pdfinfo" "/typed%2C.pdf"))
  (finish (last-run) "Pages: 2\n")
  (finish (last-run))
  (assert-equal (argv (last-run)) (list "pdfinfo" "/next.pdf"))))

(test "reopens at the saved page, fit and inversion" (lambda ()
  (test-load-plugin "./main.scm"
    (hash "configuration" (hash "file" "/books/saved.pdf")
          "replies" (hash-insert replies "DataFetch"
                      (hash "columns" (list "path" "page" "scroll" "fit" "invert")
                            "rows" (list (list (hash "Text" "/books/saved.pdf") (hash "Int" 5) (hash "Int" 3)
                                               (hash "Text" "width") (hash "Bool" #t)))
                            "truncated" #f "next_cursor" json-null))))
  (test-event (hash "PermissionRequestResult" "Granted"))
  (finish (car (runs)) "/home/test\n")
  (finish (last-run) "Pages: 9\n")
  (finish (last-run))
  (define screen (test-render 20 140))
  (assert (string-contains? screen "5/9  fit width  inverted") screen)))


(define (open-for-geometry configuration geometry)
  (test-load-plugin "./main.scm"
    (hash "configuration" (hash-insert (hash-insert configuration "file" "/geometry.pdf") "fit" "width")
          "replies" (hash-insert replies "GetCellPixelSize" geometry)))
  (test-event (hash "PermissionRequestResult" "Granted"))
  (finish (car (runs)) "/home/test\n")
  (finish (last-run) "Pages: 1\n")
  (finish (last-run)))

(define (raster-runs)
  (filter (lambda (run) (equal? (car (argv run)) "pdftoppm")) (runs)))
(define (raster-width run) (list-ref (argv run) 7))

(test "reported cell pixels draw at density one and replace geometry-dependent rasters" (lambda ()
  (open-for-geometry (hash) (hash "width" 12 "height" 22))
  (test-render 20 10)
  (define first (car (reverse (raster-runs))))
  (assert-equal (raster-width first) "120")
  (finish first "png")
  (test-render 20 10)
  (test-event (hash "CellPixelSizeChanged" (hash "width" 24 "height" 44)))
  (test-render 20 10)
  (define second (car (reverse (raster-runs))))
  (assert-equal (raster-width second) "240")
  (assert-equal (length (raster-runs)) 2)
  (finish second "png")
  (test-render 20 10)
  ;; Without a report the 12x22 fallback is a guess, drawn at density two.
  (test-event (hash "CellPixelSizeChanged" json-null))
  (test-render 20 10)
  (assert-equal (raster-width (car (reverse (raster-runs)))) "240")
  (assert-equal (length (raster-runs)) 3)))

(test "a full-screen box with large cells is rasterised within the host's image limits" (lambda ()
  (open-for-geometry (hash "density" "2") (hash "width" 22 "height" 46))
  (test-render 73 288)
  (define run (car (reverse (raster-runs))))
  (define w (string->number (raster-width run)))
  ;; 288 columns in fit width at density two would be 12672 pixels wide, over every limit.
  (assert-equal (< w 12672) #t)
  (assert-equal (<= (* 4 w (/ (* w 792) 612)) 104857600) #t)
  (test-render 20 10)
  (assert-equal (raster-width (car (reverse (raster-runs)))) "440")))

(test "explicit cell geometry overrides reports and unknown geometry uses defaults" (lambda ()
  (open-for-geometry (hash "cell_width" "7" "cell_height" "14") json-null)
  (test-render 20 10)
  (assert-equal (raster-width (car (reverse (raster-runs)))) "70")
  (test-event (hash "CellPixelSizeChanged" (hash "width" 24 "height" 44)))
  (test-render 20 10)
  (assert-equal (raster-width (car (reverse (raster-runs)))) "70")))

(test "a configured density wins over reported and fallback geometry" (lambda ()
  (open-for-geometry (hash "density" "3") (hash "width" 12 "height" 22))
  (test-render 20 10)
  (assert-equal (raster-width (car (reverse (raster-runs)))) "360")
  (finish (car (reverse (raster-runs))) "png")
  (test-render 20 10)
  (test-event (hash "CellPixelSizeChanged" json-null))
  (test-render 20 10)
  (assert-equal (raster-width (car (reverse (raster-runs)))) "360")))
