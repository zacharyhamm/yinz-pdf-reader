(test "a reader alias configured on the palette receives the pick" PALETTE-GRANTS (lambda ()
  (alias-fixture (hash "aliased.pdf" (sample-pdf 6)))
  (start 35 160 (list (hash "path" "./palette.scm" "configuration" (hash "reader" "pdf-reader"))))
