;; Real disposable sessions with the real PDF tools, palette input and fzf.

(define (pad-start text width fill)
  (string-append (make-string (max 0 (- width (string-length text))) fill) text))

;; A minimal, valid, pure-ASCII PDF: `pages` letter pages, each labelled "Page n".
;; With `extras`, pages 1–2 are labelled i and ii, pages 3–40 1 to 38 and pages
;; 41–50, an appendix whose numbering restarts, 1 to 10. The outline has "Front
;; matter" on page 1, "Chapter n" on page 10n (page 30 is printed page 28) and
;; then, out of page order, "Index" on page 5. "Section 2.1" under "Chapter 2"
;; is on page 25, and "Missing" under "Chapter 3" points at no page.
(define (sample-pdf pages . options)
  (define extras (and (pair? options) (car options)))
  (define outline-first (+ 4 (* pages 2)))
  (define (n->s n) (number->string n))
  (define (ref n) (string-append (n->s (+ 4 (* (- n 1) 2))) " 0 R"))
  (define extras-dict
    (if extras
      (string-append " /PageLabels << /Nums [0 << /S /r >> 2 << /S /D >> 40 << /S /D >>] >> /Outlines " (n->s outline-first) " 0 R")
      ""))
  (define page-objects
    (apply append
      (map (lambda (i)
             (define stream (string-append "BT /F1 48 Tf 72 680 Td (Page " (n->s i) ") Tj ET 0 0 1 rg 72 72 468 " (n->s (* i 10)) " re f"))
             (list (string-append "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 3 0 R >> >> /Contents "
                     (n->s (+ 5 (* (- i 1) 2))) " 0 R >>")
                   (string-append "<< /Length " (n->s (string-length stream)) " >>\nstream\n" stream "\nendstream")))
        (range 1 (+ pages 1)))))
  (define outline-objects
    (if (not extras) '()
      ;; Outline root, the top-level entries, then Section 2.1 and Missing.
      (let* ([root outline-first]
             [titles (list "Front matter" "Chapter 1" "Chapter 2" "Chapter 3" "Index")]
             [targets (list 1 10 20 30 5)]
             [top (map (lambda (i) (+ root 1 i)) (range 0 5))]
             [child (hash 2 (+ root 6) 3 (+ root 7))])
        (append
          (list (string-append "<< /Type /Outlines /First " (n->s (car top)) " 0 R /Last " (n->s (list-ref top 4)) " 0 R /Count 7 >>"))
          (map (lambda (i)
                 (define id (list-ref top i))
                 (define prev (if (> i 0) (string-append " /Prev " (n->s (- id 1)) " 0 R") ""))
                 (define next (if (< i 4) (string-append " /Next " (n->s (+ id 1)) " 0 R") ""))
                 (define kids (if (hash-contains? child i)
                                (let ([kid (n->s (hash-ref child i))]) (string-append " /First " kid " 0 R /Last " kid " 0 R /Count 1"))
                                ""))
                 (string-append "<< /Title (" (list-ref titles i) ") /Parent " (n->s root) " 0 R" prev next kids
                   " /Dest [" (ref (list-ref targets i)) " /Fit] >>"))
            (range 0 5))
          (list (string-append "<< /Title (Section 2.1) /Parent " (n->s (list-ref top 2)) " 0 R /Dest [" (ref 25) " /Fit] >>")
                (string-append "<< /Title (Missing) /Parent " (n->s (list-ref top 3)) " 0 R /Dest (nowhere) >>"))))))
  (define objects
    (append (list (string-append "<< /Type /Catalog /Pages 2 0 R" extras-dict " >>")
                  (string-append "<< /Type /Pages /Count " (n->s pages) " /Kids ["
                    (string-join (map (lambda (i) (string-append (n->s (+ 4 (* i 2))) " 0 R")) (range 0 pages)) " ") "] >>")
                  "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>")
            page-objects outline-objects))
  (define built
    (foldl (lambda (body acc)
             (define out (car acc))
             (define i (+ 1 (length (cdr acc))))
             (cons (string-append out (n->s i) " 0 obj\n" body "\nendobj\n") (append (cdr acc) (list (string-length out)))))
      (cons "%PDF-1.4\n" '()) objects))
  (define out (car built))
  (define xref (string-length out))
  (string-append out "xref\n0 " (n->s (+ (length objects) 1)) "\n0000000000 65535 f \n"
    (apply string-append (map (lambda (offset) (string-append (pad-start (n->s offset) 10 #\0) " 00000 n \n")) (cdr built)))
    "trailer\n<< /Size " (n->s (+ (length objects) 1)) " /Root 1 0 R >>\nstartxref\n" (n->s xref) "\n%%EOF\n"))

(define (fixture files . commands)
  (test-session "fixture" (hash "files" files "commands" (if (null? commands) (hash) (car commands)))))
(define (sample . options)
  (string-append (fixture (hash "sample.pdf" (sample-pdf 50 (and (pair? options) (car options))))) "/sample.pdf"))

(define GRANTS (hash "grants" '("RunCommands" "PluginData")))

(define (start rows columns . background)
  (test-session "start" (if (null? background) (hash "rows" rows "columns" columns)
                          (hash "rows" rows "columns" columns "backgroundPlugins" (car background))))
  (test-wait-for-text "yinz-test>"))
(define (load-reader configuration) (test-session "load" (hash "path" "./main.scm" "configuration" configuration)))
(define (key name) (test-session "key" name))
(define (type text) (test-session "text" text))
(define (screen) (test-session "screen"))
(define (panes) (test-session "panes"))
(define (no-errors) (let ([logs (test-session "logs")]) (assert (not (string-contains? logs "Error")) logs)))
(define (get h key fallback) (if (and (hash? h) (hash-contains? h key)) (hash-ref h key) fallback))
(define (string-of value) (if (string? value) value ""))

(test "pages through a document without stalling" GRANTS (lambda ()
  (define file (sample))
  (start 40 100)
  (load-reader (hash "file" file))
  (test-wait-for-text "1/50")
  (for-each (lambda (page)
              (key "n")
              (test-wait-for-text (string-append (number->string page) "/50") 5000))
    (range 2 41))
  (key "G")
  (test-wait-for-text "50/50")
  (key "g")
  (test-wait-for-text "1/50")
  (type "25")
  (key "Enter")
  (test-wait-for-text "25/50")
  (no-errors)))

(test "fit width scrolls within a page and spills to the next" GRANTS (lambda ()
  (define file (sample))
  (start 30 100)
  (load-reader (hash "file" file "fit" "width"))
  (test-wait-for-text "1/50  fit width")
  ;; A half-screen jump must stop at the bottom of the page before spilling.
  (key "d")
  (key "d")
  (key "d")
  (test-wait-for-text "1/50  fit width")
  (for-each (lambda (_) (key "j")) (range 0 40))
  (test-wait-for-text "2/50  fit width")
  (key "f")
  (test-wait-for-text "fit page")))

