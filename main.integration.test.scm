;; ---------------------------------------------------------------------------
;; The palette, the finder and the reader together.

(define PALETTE-GRANTS (hash "grants" '("RunCommands" "PluginData" "ReadApplicationState" "RunActionsAsUser")))
(define CLI "yinz --session plugin-test")
(define (quote-shell s) (string-append "'" (string-replace s "'" "'\\''") "'"))

(define (hex-value c)
  (define i (char->integer (char-downcase c)))
  (cond [(and (>= i 48) (<= i 57)) (- i 48)] [(and (>= i 97) (<= i 102)) (- i 87)] [else #f]))
;; decodeURIComponent; malformed escapes stay as they are.
(define (percent-decode s)
  (let loop ([bytes (bytes->list (string->bytes s))] [out '()])
    (cond
      [(null? bytes) (bytes->string/utf8 (list->bytes (reverse out)))]
      [(and (= (car bytes) 37) (>= (length bytes) 3)
            (hex-value (integer->char (cadr bytes))) (hex-value (integer->char (caddr bytes))))
        (loop (drop bytes 3) (cons (+ (* 16 (hex-value (integer->char (cadr bytes)))) (hex-value (integer->char (caddr bytes)))) out))]
      [else (loop (cdr bytes) (cons (car bytes) out))])))
;; File locations become absolute paths; other plugin descriptors remain opaque.
(define (strip-file url)
  (if (starts-with? url "file:")
    (string-append "/" (let loop ([s (substring url 5 (string-length url))])
                         (if (starts-with? s "/") (loop (substring s 1 (string-length s))) s)))
    url))
(define (url-path url) (if (starts-with? url "file:") (percent-decode (strip-file url)) url))

(define (palette-ready)
  (test-wait-for "palette loaded"
    (lambda () (with-handler (lambda (_) #f) (pair? (hash-ref (test-session "status" (hash "path" "./palette.scm")) "plugins"))))))

;; A "1/<n>" count standing alone, like /\b1\/\d+\b/ (or /\b1\/5\b/ with `total`).
(define (word-char? c) (or (char-alphanumeric? c) (char=? c #\_)))
(define (shows-one-of? text . total)
  (define v (string->vector text))
  (define n (vector-length v))
  (let loop ([i 0])
    (cond
      [(> (+ i 3) n) #f]
      [(and (char=? (vector-ref v i) #\1) (char=? (vector-ref v (+ i 1)) #\/)
            (or (= i 0) (not (word-char? (vector-ref v (- i 1))))))
        (let digits ([j (+ i 2)])
          (if (and (< j n) (char-digit? (vector-ref v j))) (digits (+ j 1))
            (if (and (> j (+ i 2)) (or (= j n) (not (word-char? (vector-ref v j))))
                     (or (null? total) (equal? (list->string (map (lambda (k) (vector-ref v k)) (range (+ i 2) j))) (car total))))
              #t
              (loop (+ i 1)))))]
      [else (loop (+ i 1))])))

(define (finders)
  (filter (lambda (p) (and (not (hash-ref p "is_plugin")) (string-contains? (string-of (get p "terminal_command" "")) "fzf"))) (panes)))
(define (readers . target)
  (define wanted (url-path (if (null? target) (test-resolve "./main.scm") (car target))))
  ;; File pane locations are literal paths; only file URL targets are decoded.
  ;; Git descriptors, including local source roots, compare without decoding.
  (filter (lambda (p) (and (hash-ref p "is_plugin") (string? (get p "plugin_url" #f)) (equal? (strip-file (hash-ref p "plugin_url")) wanted)))
    (panes)))

(define (palette-finder . options)
  (define query (if (null? options) "pdf open" (car options)))
  (define label (if (< (length options) 2) "Open PDF…" (cadr options)))
  (define (selected?) (not (null? (filter (lambda (line) (and (string-contains? line "›") (string-contains? line label)))
                                    (string-split (screen) "\n")))))
  (key "Ctrl Alt p")
  (type query)
  (test-wait-for-text label)
  (let loop ([tries 0])
    (unless (selected?)
      (key "Up")
      (with-handler (lambda (failure) (when (>= tries 5) (raise-error failure)))
        (test-wait-for "PDF action selected" selected? 1000))
      (loop (+ tries 1))))
  (key "Enter")
  (test-wait-for "real fzf pane" (lambda () (pair? (finders)))))

;; The host permission modal starts on Deny: Tab moves to Allow, Esc denies.
(define (answer-permissions allow)
  (if allow (begin (key "Tab") (key "Enter")) (key "Esc")))

(define (choose name pages . options)
  (define cold (and (pair? options) (car options)))
  (test-wait-for-text name)
  (type name)
  (test-wait-for "one fzf match" (lambda () (shows-one-of? (screen))))
  (key "Enter")
  (when cold
    (test-wait-for-text "Plugin permissions")
    (assert-equal (length (finders)) 0)
    (answer-permissions #t))
  (test-wait-for "PDF raster displayed"
    (lambda () (let ([s (screen)]) (and (string-contains? s (string-append "1/" (number->string pages) "  fit page"))
                                        (not (string-contains? s "rendering page"))))))
  (test-wait-for "finder retired" (lambda () (null? (finders)))))

(test "real palette aliases, non-git finder, cancellation and warm reader reuse across tabs" PALETTE-GRANTS (lambda ()
  (define home (fixture (hash "first, #?雪%2C%20%23%25%ZZ.pdf" (sample-pdf 3) "second%20.PDF" (sample-pdf 4)
                              "second .PDF" (sample-pdf 9) ".hidden/secret.pdf" (sample-pdf 8))))
  ;; The reader is tiled beside the shell; the finder lists the focused pane's
  ;; directory, so each pick starts from the shell.
  (define (focus-shell)
    (key "Alt h")
    (test-wait-for "shell focused"
      (lambda () (pair? (filter (lambda (p) (and (hash-ref p "is_focused") (not (hash-ref p "is_plugin")) (not (hash-ref p "is_floating"))))
                          (panes))))))
  (start 35 160 (list "./palette.scm"))
  (palette-ready)
  ;; Registration is asynchronous: opening the palette waits for its inventory.
  (palette-finder "pdf reader")
  (test-wait-for-text "first, #?雪%2C%20%23%25%ZZ.pdf")
  (assert (not (string-contains? (screen) "secret.pdf")))
  (key "Esc")
  (test-wait-for "finder cancelled" (lambda () (null? (finders))))
  (assert-equal (length (readers)) 0)
  (palette-finder "open document")
  (choose "first, #?雪%2C%20%23%25%ZZ.pdf" 3 #t)
  (define reader (car (readers)))
  (assert (and (not (hash-ref reader "is_floating")) (hash-ref reader "is_focused")))
  (focus-shell)
  (palette-finder "read pdf")
  (choose "second%20.PDF" 4)
  (assert-equal (map (lambda (p) (hash-ref p "id")) (readers)) (list (hash-ref reader "id")))
  (assert (hash-ref (car (readers)) "is_focused"))
  (focus-shell)
  (palette-finder "open document")
  (test-wait-for-text "first, #?雪%2C%20%23%25%ZZ.pdf")
  (key "Esc")
  (test-wait-for "warm finder cancelled" (lambda () (null? (finders))))
  (test-wait-for-text "1/4  fit page")
  (assert-equal (map (lambda (p) (hash-ref p "id")) (readers)) (list (hash-ref reader "id")))
  (test-session "action" "NewTab")
  (test-wait-for-text "yinz-test>")
  (type "cd \"$HOME\"")
  (key "Enter")
  (test-wait-for "new tab cwd" (lambda () (pair? (filter (lambda (p) (and (hash-ref p "is_focused") (equal? (get p "cwd" #f) home))) (panes)))))
  (palette-finder)
  (choose "first, #?雪%2C%20%23%25%ZZ.pdf" 3)
  (assert-equal (map (lambda (p) (hash-ref p "id")) (readers)) (list (hash-ref reader "id")))
  (assert (hash-ref (car (readers)) "is_focused"))
  (key "Ctrl Alt p")
  (type "pdf reader")
  (test-wait-for-text "Open PDF…")
  (key "Esc")
  (test-wait-for-text "1/3  fit page")
  (assert-equal (length (finders)) 0)
  (assert (string-contains? (yinz-json-string (position-rows)) (string-append home "/second%20.PDF")))))

(test "cold reader denial is visible and retires the finder" PALETTE-GRANTS (lambda ()
  (fixture (hash "denied.pdf" (sample-pdf 2)))
  (start 30 140 (list "./palette.scm"))
  (palette-ready)
  (palette-finder)
  (test-wait-for-text "denied.pdf")
  (type "denied.pdf")
  (key "Enter")
  (test-wait-for-text "Plugin permissions")
  (assert-equal (length (finders)) 0)
  (answer-permissions #f)
  (test-wait-for-text "plugin permissions denied")
  (assert-equal (length (readers)) 1)
  (assert (not (string-contains? (screen) "1/2  fit page")))))

(test "git main and linked worktrees from nested cwd preserve alias options" PALETTE-GRANTS (lambda ()
  (define home
    (fixture (hash "repo/tracked.pdf" (sample-pdf 2) "repo/deleted.pdf" (sample-pdf 8)
                   "repo/untracked.PDF" (sample-pdf 3) "repo/ignored.pdf" (sample-pdf 9)
                   "repo/notes \"draft\".pdf" (sample-pdf 4)
                   "repo/.gitignore" "ignored.pdf\n" "repo/nested/keep" ""
                   "alias.kdl" "plugins { file-finder location=\"yinz:file-finder\" { width \"80%\"; height \"70%\"; fzf_args \"--prompt=custom-pdf: --no-sort\"; }; }\n")
             (hash "setup" (string-append "set -eu\ncd \"$HOME/repo\"\ngit init -q\n"
                             "git add tracked.pdf deleted.pdf .gitignore 'notes \"draft\".pdf'\n"
                             "git -c user.name=Test -c user.email=test@example.invalid commit -qm initial\n"
                             "git worktree add -qb linked \"$HOME/linked\"\n"
                             "rm deleted.pdf \"$HOME/linked/deleted.pdf\"\n"
                             "cp untracked.PDF \"$HOME/linked/linked.PDF\"\n"
                             CLI " action reconfigure --file \"$HOME/alias.kdl\"\necho FIXTURE_READY"))))
  (start 40 160 (list "./palette.scm"))
  (palette-ready)
  (type "setup && cd \"$HOME/repo/nested\"")
  (key "Enter")
  (test-wait-for-text "FIXTURE_READY")
  (palette-finder)
  (test-wait-for-text "custom-pdf:")
  (test-wait-for-text (string-append home "/linked/linked.PDF"))
  (assert (string-contains? (screen) (string-append home "/repo/tracked.pdf")))
  (assert (string-contains? (screen) (string-append home "/repo/untracked.PDF")))
  ;; git quotes this name in its line output.
  (assert (string-contains? (screen) (string-append home "/repo/notes \"draft\".pdf")))
  (assert (not (string-contains? (screen) "ignored.pdf")))
  (assert (not (string-contains? (screen) "deleted.pdf")))
  (define finder (car (finders)))
  (assert (and (>= (hash-ref finder "pane_columns") 120) (>= (hash-ref finder "pane_rows") 25)))
  (choose "linked.PDF" 3 #t)))

