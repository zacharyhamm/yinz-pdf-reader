  (type "setup")
  (key "Enter")
  (test-wait-for-text "FIXTURE_READY")
  (palette-finder)
  (choose "aliased.pdf" 6 #t)
  ;; The pane carries the alias, not the file, so its identity survives updates.
  (assert-equal (length (filter (lambda (p) (and (hash-ref p "is_plugin") (equal? (get p "plugin_url" #f) "pdf-reader"))) (panes))) 1)
  (assert-equal (length (readers)) 0)))

(test "a folder picked in one finder lists its PDFs in the next" PALETTE-GRANTS (lambda ()
  (define home (fixture (hash "Books/it's here/deep/inner.pdf" (sample-pdf 3) "Books/it's here/.hidden/secret.pdf" (sample-pdf 8)
                              "Books/outside.pdf" (sample-pdf 4) "Papers.pdf/named.pdf" (sample-pdf 5) ".config/skip.pdf" (sample-pdf 9))))
  (start 35 160 (list "./palette.scm"))
  (palette-ready)
  (palette-finder "pdf folder" "Open PDF from folder…")
  (test-wait-for-text (string-append home "/Books/it's here/deep"))
  (assert (not (string-contains? (screen) ".config")))
  (assert (not (string-contains? (screen) "outside.pdf")))
  (type "it's here$")
  (test-wait-for "one folder match" (lambda () (shows-one-of? (screen))))
  (key "Enter")
  (test-wait-for-text (string-append home "/Books/it's here/deep/inner.pdf"))
  (assert-equal (length (finders)) 1)
  (assert (not (string-contains? (screen) "outside.pdf")))
  (assert (not (string-contains? (screen) "secret.pdf")))
  (choose "inner.pdf" 3 #t)
  ;; A folder named like a PDF is still a folder.
  (palette-finder "pdf folder" "Open PDF from folder…")
  (test-wait-for-text (string-append home "/Papers.pdf"))
  (type "Papers.pdf$")
  ;; Five folders: the reader behind shows 1/3, so match the finder's count.
  (test-wait-for "one folder match" (lambda () (shows-one-of? (screen) "5")))
  (key "Enter")
  (choose "named.pdf" 5)
  (assert-equal (length (readers)) 1)
  ;; Receiving the folder pick must not leave the palette plugin on screen.
  (assert (null? (filter (lambda (p) (and (hash-ref p "is_plugin") (ends-with? (string-of (get p "plugin_url" "")) "palette.scm")
                                          (not (get p "is_suppressed" #f))))
                   (panes))))
  (assert (not (string-contains? (screen) "palette.scm")))))

