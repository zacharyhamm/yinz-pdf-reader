(test "configuration and messages preserve literal paths with decoded-name decoys" GRANTS (lambda ()
  (define names (list "Pachev, Sasha #? 雪.pdf" "%2C.pdf" "%20.pdf" "%23.pdf" "%25.pdf" "%ZZ.pdf"))
  ;; decodeURIComponent of each name but %ZZ, which does not decode.
  (define decoys (list ",.pdf" " .pdf" "#.pdf" "%.pdf"))
  (define files
    (foldl (lambda (decoy files) (hash-insert files decoy (sample-pdf 20)))
      (foldl (lambda (i files) (hash-insert files (list-ref names i) (sample-pdf (+ i 2)))) (hash) (range 0 (length names)))
      decoys))
  (define home (fixture files))
  (start 20 140)
  (load-reader (hash "file" (string-append home "/" (car names))))
  (test-wait-for-text "1/2")
  (for-each (lambda (i)
              (define path (string-append home "/" (list-ref names i)))
              (test-session "pipe" (hash "name" "open" "payload" path))
              (test-wait-for-text (string-append "1/" (number->string (+ i 2)) "  fit page"))
              (test-wait-for "literal persisted path"
                (lambda () (string-contains? (yinz-json-string (position-rows)) path))))
    (range 0 (length names)))))

