  (define file (sample))
  (start 40 120)
  (load-reader (hash "file" file))
  (test-wait-for-text "1/50")
  ;; "Page 4" and "Page 40" to "Page 49".
  (key "/")
  (type "Page 4")
  (key "Enter")
  (test-wait-for-text "match 1/11 · page 4")
  (key "n")
  (test-wait-for-text "match 2/11 · page 40")
  (key "N")
  (test-wait-for-text "match 1/11 · page 4")
  (key "N")
  (test-wait-for-text "match 11/11 · page 49")
  (test-wait-for-text "search wrapped")
  (key "/")
  ;; Lowercase ignores case; the search starts from the current page, 49.
  (type "page 4")
  (key "Enter")
  (test-wait-for-text "match 11/11 · page 49")
  (key "/")
  (type "PAGE 4")
  (key "Enter")
  (test-wait-for-text "no matches for \"PAGE 4\"")
  (no-errors)))

