(test "density two large PNG survives navigation and open in the same reader" GRANTS (lambda ()
  ;; A real PDF with deterministic RGB noise produces a PNG above the old 2 MiB limit.
  (define home (fixture (hash "later.pdf" (sample-pdf 3))
    (hash "make-large-pdf" "set -eu\n/usr/bin/python3 - <<'PY'\nimport random, zlib\nfrom pathlib import Path\nnoise = random.Random(42).getrandbits(1024 * 1024 * 24).to_bytes(1024 * 1024 * 3, \"little\")\npixels = zlib.compress(noise)\nstream = b'q 1024 0 0 1024 0 0 cm /Im0 Do Q'\nobjects = [b'<< /Type /Catalog /Pages 2 0 R >>', b'<< /Type /Pages /Kids [3 0 R 4 0 R] /Count 2 >>']\npage = b'<< /Type /Page /Parent 2 0 R /MediaBox [0 0 1024 1024] /Resources << /XObject << /Im0 5 0 R >> >> /Contents 6 0 R >>'\nobjects += [page, page, b'<< /Type /XObject /Subtype /Image /Width 1024 /Height 1024 /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /FlateDecode /Length ' + str(len(pixels)).encode() + b' >>\\nstream\\n' + pixels + b'\\nendstream', b'<< /Length ' + str(len(stream)).encode() + b' >>\\nstream\\n' + stream + b'\\nendstream']\noutput = bytearray(b'%PDF-1.4\\n')\noffsets = []\nfor index, value in enumerate(objects, 1):\n    offsets.append(len(output))\n    output += f'{index} 0 obj\\n'.encode() + value + b'\\nendobj\\n'\nxref = len(output)\noutput += f'xref\\n0 {len(objects) + 1}\\n0000000000 65535 f \\n'.encode()\noutput += b''.join(f'{offset:010} 00000 n \\n'.encode() for offset in offsets)\noutput += f'trailer << /Size {len(objects) + 1} /Root 1 0 R >>\\nstartxref\\n{xref}\\n%%EOF\\n'.encode()\nPath.home().joinpath('noise.pdf').write_bytes(output)\n\nPY\necho LARGE_PDF_READY"
          "mutool" "set -eu\nreal_mutool=$(PATH=\"${PATH#*:}\" command -v mutool)\nif [ \"$1\" != draw ]; then exec \"$real_mutool\" \"$@\"; fi\npng=$(mktemp \"$HOME/raster.XXXXXX\")\ntrap 'rm -f \"$png\"' EXIT\n\"$real_mutool\" \"$@\" > \"$png\"\nsize=$(wc -c < \"$png\")\nif [ \"$size\" -gt 2097152 ] && [ \"$size\" -le 8388608 ]; then\n  printf '%s\\n' \"$size\" > \"$HOME/large-raster-seen\"\nfi\ncat \"$png\"\n"
          "inspect-large-raster" "set -eu\ntest -s \"$HOME/large-raster-seen\"\nprintf \"LARGE_RASTER_BYTES=\"\ncat \"$HOME/large-raster-seen\"")))
  (start 35 140)
  (type "make-large-pdf")
  (key "Enter")
  (test-wait-for-text "LARGE_PDF_READY")
  ;; Fixed test cells and density two make the physical raster repeatable and large.
  (load-reader (hash "file" (string-append home "/noise.pdf") "cell_width" "12" "cell_height" "18" "density" "2"))
  (test-wait-for-text "1/2  fit page")
  (test-session "action" "ToggleFocusFullscreen")
  (define identity (map (lambda (p) (hash-ref p "id")) (readers)))
  (define (rendered-page text)
    (test-wait-for "large page rendered"
      (lambda () (define current (screen))
        (and (string-contains? current text) (not (string-contains? current "rendering page")))) 20000))
  (rendered-page "1/2  fit page")
  (for-each (lambda (_) (key "n") (rendered-page "2/2  fit page")
                        (key "p") (rendered-page "1/2  fit page")) (range 0 3))
  (test-session "pipe" (hash "name" "open" "payload" (string-append home "/later.pdf")))
  (rendered-page "1/3  fit page")
  (assert-equal (map (lambda (p) (hash-ref p "id")) (readers)) identity)
  (test-session "action" "NewTab")
  (test-wait-for-text "yinz-test>")
  (type "inspect-large-raster")
  (key "Enter")
  (test-wait-for-text "LARGE_RASTER_BYTES=")
  (displayln (car (filter (lambda (line) (starts-with? line "LARGE_RASTER_BYTES=")) (string-split (screen) "\n"))))
  (no-errors)))
